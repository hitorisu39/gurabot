# ---------------------------------------------------------
# Docker deployment
# ---------------------------------------------------------
APP_IMAGE=ghcr.io/hitorisu39/gurabot
APP_IMAGE_TAG=1.0.0

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_NAME=gurabot
APP_MODE=development
APP_LOGLEVEL=debug
APP_PREFIX=!
APP_CACHE=cache
APP_RESOURCES=resources
APP_DOMAIN=https://gurabot.com
APP_FLAGS_DOMAIN=https://raw.githubusercontent.com/hitorisu39/flags-png/main/png256px/
APP_SUPPORT_SERVER=https://discord.gg/Ed4yeNgWxj
APP_DONATE=https://ko-fi.com/cornosu
APP_INVITE=https://discord.com/api/oauth2/authorize?client_id=777206490280755211&permissions=309238025216&scope=bot%20applications.commands

# ---------------------------------------------------------
# Web
# ---------------------------------------------------------
WEB_AUTH_DOMAIN=https://auth.gurabot.com
WEB_AUTH_PORT=3001

# ---------------------------------------------------------
# Discord
# ---------------------------------------------------------
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_SHARDS_PER_CLUSTER=3
DISCORD_DEV_ID=421719429034803202

# ---------------------------------------------------------
# Database (Prisma/PostgreSQL)
# ---------------------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_NAME=gurabot
DATABASE_CONNECTION_LIMIT=10

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------------------------------------------------
# osu!
# ---------------------------------------------------------
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:3001/oauth/osu

# ---------------------------------------------------------
# Twitch
# ---------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/oauth/twitch

# ---------------------------------------------------------
# Calculator
# ---------------------------------------------------------
CALCULATOR_HOST=localhost
CALCULATOR_PORT=5000

# ---------------------------------------------------------
# Prometheus
# ---------------------------------------------------------
PROMETHEUS_PORT=9090

# ---------------------------------------------------------
# Loki
# ---------------------------------------------------------
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100
LOKI_PORT=3100

# ---------------------------------------------------------
# Grafana
# ---------------------------------------------------------
GRAFANA_USERNAME=admin
# If you're gonna run monitoring, replace this with better pw.
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
GRAFANA_DOMAIN=
GRAFANA_ROOT_URL=
