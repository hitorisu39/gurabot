model StandardDifficultyAttributes {
    beatmapID                       Int         @map("beatmap_id")
    mods                            String
    custom                          Boolean

    starRating                      Float       @map("star_rating")
    maxCombo                        Int         @map("max_combo")

    // Effective beatmap attributes
    cs                              Float
    ar                              Float
    od                              Float
    hp                              Float
    clockRate                       Float       @map("clock_rate")

    aimDifficulty                   Float       @map("aim_difficulty")
    aimDifficultSliderCount         Float       @map("aim_difficult_slider_count")

    speedDifficulty                 Float       @map("speed_difficulty")
    speedNoteCount                  Float       @map("speed_note_count")

    flashlightDifficulty            Float       @map("flashlight_difficulty")

    readingDifficulty               Float?      @map("reading_difficulty")
    readingDifficultNoteCount       Float?      @map("reading_difficult_note_count")

    sliderFactor                    Float       @map("slider_factor")

    aimTopWeightedSliderFactor      Float       @map("aim_top_weighted_slider_factor")
    speedTopWeightedSliderFactor    Float       @map("speed_top_weighted_slider_factor")

    aimDifficultStrainCount         Float       @map("aim_difficult_strain_count")
    speedDifficultStrainCount       Float       @map("speed_difficult_strain_count")

    nestedScorePerObject            Float       @map("nested_score_per_object")
    maximumLegacyComboScore         Float       @map("maximum_legacy_combo_score")
    legacyScoreBaseMultiplier       Float       @map("legacy_score_base_multiplier")

    hitCircleCount                  Int         @map("hit_circle_count")
    sliderCount                     Int         @map("slider_count")
    spinnerCount                    Int         @map("spinner_count")

    createdAt                       DateTime    @map("created_at") @default(now())
    updatedAt                       DateTime    @map("updated_at") @updatedAt @default(now())

    @@id([beatmapID, mods])
    @@map("standard_difficulty_attributes")
}

