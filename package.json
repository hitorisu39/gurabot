{
    "name": "gurabot",
    "version": "0.2.1",
    "description": "A simple osu! Discord bot with a bunch of features",
    "main": "index.js",
    "scripts": {
        "build": "yarn build:adapter && yarn build:calculator && yarn build:bot",
        "build:bot": "rimraf dist && tsc && tsc-alias",
        "build:adapter": "npx tsx scripts/adapter.ts",
        "build:calculator": "npx tsx scripts/calculator.ts build",
        "build:prod": "yarn build:adapter && yarn generate:calculator && yarn build:bot",
        "generate:calculator": "npx tsx scripts/calculator.ts types",
        "start": "node dist/src/index.js",
        "start:prod": "node dist/src/sharder.js",
        "start:calculator": "npx tsx scripts/calculator.ts run",
        "dev": "yarn build:bot && concurrently \"yarn start:calculator\" \"yarn start\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",

        "docker:network": "docker network inspect gurabot_monitoring >/dev/null 2>&1 || docker network create gurabot_monitoring",

        "docker:prod": "docker compose --profile prod pull && docker compose --profile prod up -d --no-build --remove-orphans --wait",
        "docker:prod:up": "docker compose --profile prod up -d --no-build --remove-orphans --wait",
        "docker:prod:down": "docker compose --profile prod down",
        "docker:prod:logs": "docker compose --profile prod logs -f --tail 100",
        "docker:prod:status": "docker compose --profile prod ps",

        "docker:monitoring": "docker compose --env-file .env -f monitoring/docker-compose.yml pull && docker compose --env-file .env -f monitoring/docker-compose.yml up -d --remove-orphans",
        "docker:monitoring:up": "docker compose --env-file .env -f monitoring/docker-compose.yml up -d --remove-orphans --wait",
        "docker:monitoring:down": "docker compose --env-file .env -f monitoring/docker-compose.yml down",
        "docker:monitoring:logs": "docker compose --env-file .env -f monitoring/docker-compose.yml logs -f --tail 100",
        "docker:monitoring:status": "docker compose --env-file .env -f monitoring/docker-compose.yml ps",

        "docker:all": "yarn docker:network && yarn docker:monitoring && yarn docker:prod",
        "docker:all:status": "yarn docker:monitoring:status && yarn docker:prod:status"
    },
    "author": "hitorisu",
    "license": "MIT",
    "dependencies": {
        "@bufbuild/protobuf": "^2.11.0",
        "@connectrpc/connect": "^2.1.1",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@types/convict": "^6.1.6",
        "@types/pg": "^8.18.0",
        "axios": "^1.18.0",
        "canvas": "^3.2.3",
        "chart.js": "^4.5.1",
        "chartjs-node-canvas": "^5.0.0",
        "class-transformer": "^0.5.1",
        "cli-table3": "^0.6.5",
        "convict": "^6.2.5",
        "dayjs": "^1.11.20",
        "discord-hybrid-sharding": "^3.0.1",
        "discord.js": "^14.25.1",
        "dotenv": "^17.3.1",
        "glob": "^13.0.6",
        "ioredis": "^5.10.0",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-loki": "^3.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.4.2",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "sharp": "^0.35.3",
        "socket.io-client": "^4.8.3",
        "yarn": "^1.22.22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^9.2.1",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "grpc-tools": "^1.13.1",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "ts-proto": "^2.11.5",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.0"
    }
}
