{
    "name": "gurabot",
    "version": "0.0.1",
    "description": "A simple osu! Discord bot with a lot of features",
    "main": "index.js",
    "scripts": {
        "build": "yarn build:adapter && yarn build:calculator && yarn build:bot",
        "build:bot": "rimraf dist && tsc && tsc-alias",
        "build:adapter": "npx tsx scripts/adapter.ts",
        "build:calculator": "npx tsx scripts/calculator.ts build",
        "build:prod": "yarn build:adapter && yarn build:bot",
        "start": "node dist/src/index.js",
        "start:prod": "node dist/src/sharder.js",
        "start:calculator": "npx tsx scripts/calculator.ts run",
        "dev": "tsc --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:dev": "docker compose -p gurabot-dev -f docker-compose.dev.yml --profile dev up -d",
        "docker:prod": "docker compose -p gurabot-production -f docker-compose.yml --profile prod build --no-cache && docker compose --profile prod up -d",
        "docker:down": "docker compose --profile prod down",
        "docker:logs": "docker compose --profile prod logs -f",
        "docker:db-wipe": "docker compose down -v"
    },
    "author": "hitorisu",
    "license": "ISC",
    "dependencies": {
        "@bufbuild/protobuf": "^2.11.0",
        "@connectrpc/connect": "^2.1.1",
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@types/convict": "^6.1.6",
        "@types/pg": "^8.18.0",
        "axios": "^1.13.6",
        "chart.js": "^4.5.1",
        "chartjs-node-canvas": "^5.0.0",
        "class-transformer": "^0.5.1",
        "cli-table3": "^0.6.5",
        "convict": "^6.2.4",
        "dayjs": "^1.11.20",
        "discord-hybrid-sharding": "^3.0.1",
        "discord.js": "^14.25.1",
        "dotenv": "^17.3.1",
        "glob": "^13.0.6",
        "ioredis": "^5.10.0",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-loki": "^3.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.4.2",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "yarn": "^1.22.22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "grpc-tools": "^1.13.1",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "ts-proto": "^2.11.5",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.0"
    }
}
